# Exemplu configurare variabile de mediu (Vercel Serverless / Local)
# Nu introduce secrete reale in acest fisier!

# Cheie API Resend pentru trimiterea notificarilor din /api/contact (obligatorie in prod)
RESEND_API_KEY=re_placeholder_key

# Adrese email notificare (optional - exista valori implicite sigure pentru domeniu)
ADMIN_NOTIFICATION_EMAIL=contact@tiberiumilitaru.ro
NOTIFICATION_FROM_EMAIL=Militaru Tiberiu Nicolae <contact@tiberiumilitaru.ro>

# Rate limiter distribuit Upstash Redis / Vercel KV (recomandat in productie)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
